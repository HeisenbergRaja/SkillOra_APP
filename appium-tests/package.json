{
  "name": "skillora-appium-tests",
  "version": "1.0.0",
  "description": "Appium E2E tests for Skillora Android App",
  "main": "index.js",
  "scripts": {
    "test:android": "NODE_OPTIONS=\"\" wdio run wdio.conf.js",
    "test:android:serial": "NODE_OPTIONS=\"\" wdio run wdio.conf.js --maxInstances 1",
    "test:android:smoke": "NODE_OPTIONS=\"\" wdio run wdio.conf.js --spec ./tests/smoke/01-smoke-test.js"
  },
  "devDependencies": {
    "@wdio/cli": "^8.36.1",
    "@wdio/local-runner": "^8.36.1",
    "@wdio/mocha-framework": "^8.36.1",
    "@wdio/spec-reporter": "^8.36.1",
    "@wdio/json-reporter": "^8.36.1",
    "appium": "^2.5.1",
    "appium-uiautomator2-driver": "^3.0.5",
    "exceljs": "^4.4.0"
  }
}
